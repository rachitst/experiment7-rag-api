# Copy this file to ".env" and fill in your own key.  NEVER commit .env or share it.

# --- LLM backend (cloud-hosted, OpenAI-compatible chat completions API) ---
LLM_BACKEND=openai_compatible
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b
LLM_API_KEY=paste-your-groq-api-key-here
LLM_TIMEOUT_SECONDS=30
LLM_MAX_TOKENS=300

# Alternative providers (same code, change the three values above):
#   Hugging Face router : LLM_BASE_URL=https://router.huggingface.co/v1   LLM_MODEL=<model id from the HF hub>
#   OpenRouter          : LLM_BASE_URL=https://openrouter.ai/api/v1       LLM_MODEL=<a ":free" model id>
# Offline test without any key:  LLM_BACKEND=mock

# --- Retrieval ---
RAG_TOP_K=3
RAG_MAX_DISTANCE=1.5
